# Les réglages et les secrets de la boutique. CE fichier est un modèle : il va dans Git.
# Le vrai, c'est .env, qui ne va JAMAIS dans Git (il est dans .gitignore) :
#   cp .env.exemple .env
#   chmod 600 .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 16)/" .env
#   sed -i "s/^REDIS_PASSWORD=.*/REDIS_PASSWORD=$(openssl rand -hex 16)/" .env
POSTGRES_DB=boutique
POSTGRES_USER=mboa
POSTGRES_PASSWORD=a-changer
REDIS_PASSWORD=a-changer

# Où arrivent les sauvegardes, sur la machine : hors du dépôt, pour qu'elles ne partent jamais sur GitHub.
DOSSIER_SAUVEGARDES=/var/backups/mboa-market
